nextflow_process {
    name "Test NTMPROFILER_COLLATE"
    script "../main.nf"
    process "NTMPROFILER_COLLATE"
    tag "modules"
    tag "ntmprofiler"
    tag "ntmprofiler_collate"

    test("ntmprofiler collate - module - test") {
        when {
            params {
                test_data_dir = System.getenv("BACTOPIA_TESTS") ?: ""
            }
            process {
                """
                input[0] = Channel.of(
                    record(
                        meta: [name: "ntmprofiler"],
                        json: [
                            file("${params.test_data_dir}/datasets/ntmprofiler/illumina/ERR1045534.results.json.gz")
                        ]
                    )
                )
                input[1] = file("${params.test_data_dir}/datasets/ntmprofiler/ntmprofiler.tar.gz")
                """
            }
        }

        then {
            def record = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert snapshot(
                    record.meta,
                    record.csv,
                    record.variants_csv,
                    record.versions
                ).match() }
            )
        }
    }
}
