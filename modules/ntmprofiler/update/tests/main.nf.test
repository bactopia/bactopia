nextflow_process {
    name "Test NTMPROFILER_UPDATE"
    script "../main.nf"
    process "NTMPROFILER_UPDATE"
    tag "modules"
    tag "ntmprofiler"
    tag "ntmprofiler_update"

    // Requires internet access and builds the complete NTM-Profiler database.
    test("ntmprofiler/update - module - download") {
        when {
            process {
                """
                // No inputs required - download module
                """
            }
        }

        then {
            def record = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert record.db },
                { assert record.versions }
            )
        }
    }
}
