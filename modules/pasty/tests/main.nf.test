nextflow_process {
    name "Test PASTY"
    script "../main.nf"
    process "PASTY"
    tag "modules"
    tag "pasty"

    test("pasty - module - GCF_000006765") {
        when {
            params {
                test_data_dir = System.getenv("BACTOPIA_TESTS") ?: ""
            }
            process {
                """
                input[0] = Channel.of(
                    record(
                        meta: [name: "GCF_000006765"],
                        fna: file("${params.test_data_dir}/species/pseudomonas_aeruginosa/GCF_000006765/main/assembler/GCF_000006765.fna.gz")
                    )
                )
                """
            }
        }

        then {
            def record = process.out[0][0]
            assertAll(
                { assert process.success },
                // Reproducible outputs
                { assert snapshot(
                    record.meta,
                    record.blast
                ).match() },
                // Non-reproducible outputs
                { assert [
                    record.tsv,
                    record.details
                ].every { path(it).exists() } },
                { assert path(record.versions[0]).text.contains('pasty') }
            )
        }
    }
}
