// Minimal config for subworkflow-level testing of PBPTYPER
nextflow.enable.types = true
nextflow.enable.strict = true
includeConfig "../../../conf/test_base.config"

params {
    workflow {
        name = "pbptyper"
        logo_name = "bactopia-tools"
        description = "In silico PBP typing of Streptococcus pneumoniae"
        ext = "fna"
    }
    wf = params.workflow.name
}

// Load module configs for processes in this subworkflow
includeConfig "../../../modules/pbptyper/module.config"
includeConfig "../../../modules/csvtk/concat/module.config"

// Base config (container resolution + resource labels)
includeConfig "../../../conf/base.config"
includeConfig "../../../conf/profiles.config"
