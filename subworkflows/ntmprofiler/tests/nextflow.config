// Minimal config for subworkflow-level testing of NTMPROFILER
nextflow.enable.types = true
nextflow.enable.strict = true
includeConfig "../../../conf/test_base.config"

params {
    workflow {
        name = "ntmprofiler"
        logo_name = "bactopia-tools"
        description = "Identify NTM species and predict antimicrobial resistance"
        ext = "fastq"
    }
    wf = params.workflow.name
}

// Load module configs for processes in this subworkflow
includeConfig "../../../modules/ntmprofiler/profile/module.config"
includeConfig "../../../modules/ntmprofiler/collate/module.config"
includeConfig "../../../modules/ntmprofiler/update/module.config"

// Base config (container resolution + resource labels)
includeConfig "../../../conf/base.config"
includeConfig "../../../conf/profiles.config"
