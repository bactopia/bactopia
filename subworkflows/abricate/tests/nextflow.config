// Minimal config for subworkflow-level testing of ABRICATE
nextflow.enable.types = true
nextflow.enable.strict = true
includeConfig "../../../conf/test_base.config"

params {
    workflow {
        name = "abricate"
        logo_name = "bactopia-tools"
        description = "Mass screening of contigs for antimicrobial and virulence genes"
        ext = "fna"
    }
    wf = params.workflow.name
}

// Load module configs for both processes in this subworkflow
includeConfig "../../../modules/abricate/run/module.config"
includeConfig "../../../modules/abricate/summary/module.config"

// Base config (container resolution + resource labels)
includeConfig "../../../conf/base.config"
includeConfig "../../../conf/profiles.config"
