// Minimal config for subworkflow-level testing of DEACON
nextflow.enable.types = true
nextflow.enable.strict = true
includeConfig "../../../conf/test_base.config"

params {
    workflow {
        name = "deacon"
        logo_name = "bactopia-tools"
        description = "Remove host reads from sequencing data"
        ext = "fna"
    }
    wf = params.workflow.name
}

// Load module configs for ALL processes used by this subworkflow
includeConfig "../../../modules/deacon/fetch/module.config"
includeConfig "../../../modules/deacon/filter/module.config"

// Base config (container resolution + resource labels)
includeConfig "../../../conf/base.config"
includeConfig "../../../conf/profiles.config"
